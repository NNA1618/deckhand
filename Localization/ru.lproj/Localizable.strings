/* == codex == */
"section.codex" = "Codex";
"section.codex.subtitle" = "Сессии OpenAI Codex у чёлки — из Терминала, редакторов и приложения ChatGPT.";
"search.codex.labels" = "Подключение; Разрешения из чёлки; Ждать ответа; Codex ждёт вас; Codex закончил задачу; Звук";
